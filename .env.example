# hermes-lixian 环境变量示例（复制为 .env 后按需填写）
# 启动前: set HERMES_HOME=D:\hermes-lixian\var\hermes
# 或使用 chat.ps1

ES_HOST=
ES_USERNAME=
ES_PASSWORD=
IDENTITY_INDEX=dw_identity_info_lk_country_wise_new_all
ORG_INDEX=dw_org_info_lk_company

# 主模型（与 config.yaml 一致）
DEEPSEEK_API_KEY=

# hermes-lixian 环境变量示例（复制为 .env 后按需填写）
# Windows: .\chat.ps1 gateway
# Ubuntu:  ./chat.sh gateway
# chat 脚本会设置 HERMES_HOME=<repo>/var/hermes、LIXIAN_ROOT、LIXIAN_PYTHON

ES_HOST=
ES_USERNAME=
ES_PASSWORD=
IDENTITY_INDEX=dw_identity_info_lk_country_wise_new_all
ORG_INDEX=dw_org_info_lk_company

# MCP 路径（一般不用手写；chat.sh / chat.ps1 会自动注入）
# LIXIAN_ROOT=/opt/hermes-lixian
# LIXIAN_PYTHON=/opt/hermes-lixian/hermes-agent/venv/bin/python

# Hermes API Server（gateway 读 HERMES_HOME/.env）
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
# 单机仅本仓库：8642；同机已有 hermes-xa 时请改成 8643，并同步改 Java hermes.base-url
API_SERVER_PORT=8642
API_SERVER_KEY=change-me-local-dev

# 主模型在 config.yaml：custom → http://172.200.200.1:8004/v1
# model: Qwen3.8-27B（该端点无需 API Key）
# 若改回官方 DeepSeek，再填写：
# DEEPSEEK_API_KEY=

# 组织 DeepSeek 精标（可选）
# ORG_TAG_BASE_URL=http://172.200.200.4:7000/v1
# ORG_TAG_MODEL=dsv4-dspark
# ORG_TAG_API_KEY=

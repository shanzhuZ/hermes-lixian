{
  "info": {
    "_postman_id": "a1b2c3d4-lixian-chat-stream",
    "name": "lixian-chat 流式问答",
    "description": "hermes-lixian Java 网关测试集合。\n\n推荐顺序：\n1) 创建会话\n2) 提问 ask\n3) 订阅流式 stream（ask 后尽快点 Send）\n4) 查询任务快照\n\n说明：Postman 对 SSE 支持有限，stream 请求请看 Body 原始文本中的 event/data；也可用 curl -N 对照。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8088"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "hermesSessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1-会话",
      "item": [
        {
          "name": "创建会话 POST /api/chat/sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('返回 sessionId', function () {",
                  "  pm.expect(json.sessionId).to.be.a('string').and.not.empty;",
                  "});",
                  "if (json.sessionId) {",
                  "  pm.collectionVariables.set('sessionId', json.sessionId);",
                  "}",
                  "if (json.hermesSessionId) {",
                  "  pm.collectionVariables.set('hermesSessionId', json.hermesSessionId);",
                  "}",
                  "console.log('sessionId=', json.sessionId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"postman联调\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/sessions",
            "description": "创建业务会话，自动映射 Hermes session。"
          },
          "response": []
        },
        {
          "name": "查询会话 GET /api/chat/sessions/{sessionId}",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('sessionId 匹配', function () {",
                  "  pm.expect(json.sessionId).to.eql(pm.collectionVariables.get('sessionId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/sessions/{{sessionId}}",
            "description": "查询内存中的会话信息。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2-提问",
      "item": [
        {
          "name": "提问 ask（带 sessionId）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('返回 taskId', function () {",
                  "  pm.expect(json.taskId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('status=running', function () {",
                  "  pm.expect(json.status).to.eql('running');",
                  "});",
                  "if (json.taskId) {",
                  "  pm.collectionVariables.set('taskId', json.taskId);",
                  "}",
                  "if (json.sessionId) {",
                  "  pm.collectionVariables.set('sessionId', json.sessionId);",
                  "}",
                  "console.log('taskId=', json.taskId);",
                  "console.log('下一步立刻请求 stream');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"userId\": \"u001\",\n  \"message\": \"你好，介绍一下你自己\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "发起问答，立即返回 taskId；结束后写入 ES sz_lixian_xw。随后可订阅流式。"
          },
          "response": []
        },
        {
          "name": "取消任务 cancel（按 taskId）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('ok=true', function () {",
                  "  pm.expect(json.ok).to.eql(true);",
                  "});",
                  "console.log(json);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskId\": \"{{taskId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/cancel",
            "description": "取消指定 task。也可传 sessionId 取消该会话下所有 running 任务。"
          },
          "response": []
        },
        {
          "name": "取消任务 cancel（按 sessionId）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/cancel",
            "description": "取消该会话下所有进行中的任务。"
          },
          "response": []
        },
        {
          "name": "提问 ask（组织查询）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.taskId) {",
                  "  pm.collectionVariables.set('taskId', json.taskId);",
                  "}",
                  "if (json.sessionId) {",
                  "  pm.collectionVariables.set('sessionId', json.sessionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"查询美国涉华智库\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "业务样例：组织查询（依赖 Hermes + MCP）。"
          },
          "response": []
        },
        {
          "name": "提问 ask（不传 sessionId，自动建会话）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('自动生成 sessionId/taskId', function () {",
                  "  pm.expect(json.sessionId).to.be.ok;",
                  "  pm.expect(json.taskId).to.be.ok;",
                  "});",
                  "pm.collectionVariables.set('sessionId', json.sessionId);",
                  "pm.collectionVariables.set('taskId', json.taskId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"简单说一句你好即可\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "不传 sessionId 时服务端自动创建会话。"
          },
          "response": []
        },
        {
          "name": "提问 ask（空 message，期望错误）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 且 ok=false 或有错误信息', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.ok === false || json.message).to.be.ok;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "负向用例：message 为空。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3-流式与任务",
      "item": [
        {
          "name": "订阅流式 GET /api/chat/tasks/{taskId}/stream",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('taskId')) {",
                  "  console.warn('taskId 为空：请先执行 ask');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('能收到响应', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "var text = pm.response.text() || '';",
                  "pm.test('含 SSE 关键字（connected 或 event:）', function () {",
                  "  pm.expect(text.includes('connected') || text.includes('event:') || text.includes('assistant')).to.be.true;",
                  "});",
                  "console.log('SSE 片段预览:\\n' + text.substring(0, 800));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Cache-Control",
                "value": "no-cache"
              }
            ],
            "url": "{{baseUrl}}/api/chat/tasks/{{taskId}}/stream",
            "description": "SSE 订阅。\n\n事件示例：connected / status / assistant.delta / tool.started / tool.completed / error / stream_end\n\n注意：Postman 可能等流结束后才展示全文；联调时 ask 后立刻点 Send。超时可在 Settings 调大 Request timeout。"
          },
          "response": []
        },
        {
          "name": "查询任务 GET /api/chat/tasks/{taskId}",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('含 status', function () {",
                  "  pm.expect(json.status).to.be.ok;",
                  "});",
                  "console.log('status=', json.status);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/tasks/{{taskId}}",
            "description": "查询任务内存快照：running/end/cancelled/failed 及 answer。"
          },
          "response": []
        },
        {
          "name": "订阅流式（task 不存在）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var text = pm.response.text() || '';",
                  "pm.test('提示 task 不存在', function () {",
                  "  pm.expect(text.includes('不存在') || text.includes('error')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": "{{baseUrl}}/api/chat/tasks/task_not_exist/stream",
            "description": "负向用例：错误 taskId。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4-多轮（同一 session）",
      "item": [
        {
          "name": "多轮-第二问",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.taskId) {",
                  "  pm.collectionVariables.set('taskId', json.taskId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"再筛选其中与半导体相关的\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "同一 sessionId 继续提问，验证多轮上下文（依赖 Hermes session）。执行后立刻再打 stream。"
          },
          "response": []
        }
      ]
    }
  ]
}

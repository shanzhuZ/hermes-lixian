{
  "info": {
    "_postman_id": "a1b2c3d4-hermes-xw-chat-001",
    "name": "hermes-xw Chat API",
    "description": "hermes-xw 对话网关测试集。\n\n推荐顺序：\n1. 列出 Skills\n2. 新建 Session\n3. Ask（会写入 sessionId/taskId 到环境变量）\n4. 轮询 Get Task\n5. 同 Session 追问 / 查历史\n\n变量：baseUrl 默认 http://127.0.0.1:4378",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4378" },
    { "key": "sessionId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "hermesSessionId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Skills",
      "item": [
        {
          "name": "列出四个 Skill 触发词",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/skills",
            "description": "返回四个 research skill 及其触发词。"
          }
        }
      ]
    },
    {
      "name": "1. Session",
      "item": [
        {
          "name": "新建会话",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('sessionId', j.data.sessionId);",
                  "  pm.collectionVariables.set('hermesSessionId', j.data.hermesSessionId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman 测试会话\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/sessions",
            "description": "创建业务 session，并在 Hermes 侧创建 hermesSessionId。"
          }
        },
        {
          "name": "查询会话",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/sessions/{{sessionId}}"
          }
        },
        {
          "name": "会话任务列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/sessions/{{sessionId}}/tasks"
          }
        },
        {
          "name": "会话消息历史",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{sessionId}}/messages?limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "sessions", "{{sessionId}}", "messages"],
              "query": [
                { "key": "limit", "value": "200" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Ask（四 Skill 示例）",
      "item": [
        {
          "name": "Ask - 法案研判（显式 skill）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('sessionId', j.data.sessionId);",
                  "  pm.collectionVariables.set('taskId', j.data.taskId);",
                  "  if (j.data.hermesSessionId) {",
                  "    pm.collectionVariables.set('hermesSessionId', j.data.hermesSessionId);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"研判 H.R.9028 中华人民共和国经纪商和投资顾问暂停法案，涉华重点写观点与影响\",\n  \"skill\": \"bill-impact-analysis\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "异步：立刻返回 pending + taskId。再用「查询任务」或 SSE stream 看结果。"
          }
        },
        {
          "name": "Ask - 同步等待终稿（wait=true）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('sessionId', j.data.sessionId);",
                  "  pm.collectionVariables.set('taskId', j.data.taskId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"研判 H.R.9028 中华人民共和国经纪商和投资顾问暂停法案，涉华重点写观点与影响\",\n  \"skill\": \"bill-impact-analysis\",\n  \"wait\": true\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "同步阻塞到 done/failed（可能很久，Postman 超时请调大）。返回里带 answerMarkdown。"
          }
        },
        {
          "name": "Ask - 组织画像（触发词自动路由）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('sessionId', j.data.sessionId);",
                  "  pm.collectionVariables.set('taskId', j.data.taskId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"获取组织画像，自由之家\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask"
          }
        },
        {
          "name": "Ask - 账号画像",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('taskId', j.data.taskId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"社交账号画像，Twitter @freedomhouse\",\n  \"skill\": \"account-portrait\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask"
          }
        },
        {
          "name": "Ask - 事件传播影响",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('taskId', j.data.taskId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"热点事件传播影响：请分析近期与某法案相关的公开讨论时间线与主要传播账号\",\n  \"skill\": \"event-spread-impact\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask"
          }
        },
        {
          "name": "Ask - 无 session 自动新建",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('sessionId', j.data.sessionId);",
                  "  pm.collectionVariables.set('taskId', j.data.taskId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"法案发言 H.R.8365\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "不传 sessionId 时服务端自动建会话。"
          }
        },
        {
          "name": "Ask - 同 Session 追问",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.code).to.eql(0);",
                  "  pm.collectionVariables.set('taskId', j.data.taskId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"请在上一轮基础上，补充涉华观点与影响研判（事实与推断分开）\",\n  \"skill\": \"bill-impact-analysis\"\n}"
            },
            "url": "{{baseUrl}}/api/chat/ask",
            "description": "同一 sessionId → 复用 hermesSessionId 多轮上下文；新 taskId。"
          }
        }
      ]
    },
    {
      "name": "3. Task",
      "item": [
        {
          "name": "查询任务（轮询）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var j = pm.response.json();",
                  "if (j && j.data) {",
                  "  console.log('status=', j.data.status);",
                  "  if (j.data.status === 'done') {",
                  "    console.log('answer length=', (j.data.answerMarkdown || '').length);",
                  "  }",
                  "  if (j.data.status === 'failed') {",
                  "    console.log('error=', j.data.errorMessage);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/tasks/{{taskId}}",
            "description": "status: pending → running → done | failed。done 时看 answerMarkdown。"
          }
        },
        {
          "name": "任务状态 SSE 流",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "url": "{{baseUrl}}/api/chat/tasks/{{taskId}}/stream",
            "description": "实时转发 Hermes SSE（assistant.delta / tool.* / done）。"
          }
        },
        {
          "name": "任务工具事件",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/tasks/{{taskId}}/tools",
            "description": "Hook 入库的工具审计列表。"
          }
        },
        {
          "name": "任务归一化命中",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/tasks/{{taskId}}/hits?hitType=&platform=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "tasks", "{{taskId}}", "hits"],
              "query": [
                { "key": "hitType", "value": "", "description": "profile|post|candidate|search|document|other" },
                { "key": "platform", "value": "", "description": "twitter|weibo|youtube|..." }
              ]
            },
            "description": "归一化可查询命中；可选 hitType / platform 过滤。"
          }
        },
        {
          "name": "任务粗阶段（法案）",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/tasks/{{taskId}}/phases",
            "description": "方案D：计划步骤列表 + currentPhase。目前法案 Skill 会写入。"
          }
        }
      ]
    }
  ]
}
